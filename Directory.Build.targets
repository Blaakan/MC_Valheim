<Project>
  <!--
    Me run after csproj body, so me can see ModName, Version, etc.
    Me do: check mod metadata, make ModInfo.g.cs, copy mod dll into game BepInEx/plugins.
  -->

  <PropertyGroup Condition="'$(IsMod)' == 'true'">
    <!-- Thunderstore name no allow dots. Me smash feature id: Crossbow.StaysLoaded -> CrossbowStaysLoaded. -->
    <ModPackageName Condition="'$(ModPackageName)' == '' and '$(ModFeatureId)' != ''">$(ModFeatureId.Replace('.', ''))</ModPackageName>
    <ModSide Condition="'$(ModSide)' == ''">Client</ModSide>
    <ModMultiplayer Condition="'$(ModMultiplayer)' == ''">Compatible</ModMultiplayer>
    <!-- Bump when RPC names/payloads or ZDO keys/format change (Both mods: client and server must match). -->
    <ModNetworkVersion Condition="'$(ModNetworkVersion)' == ''">1</ModNetworkVersion>
    <DeployToGame Condition="'$(DeployToGame)' == '' and '$(Configuration)' == 'Debug'">true</DeployToGame>
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
    <!-- BepInEx scan plugins/ recursively, so nesting is fine. One tidy folder for the whole collection. -->
    <ModDeployDir>$(BepInExDir)plugins\$(ModCollectionFolder)\$(ModCategory)\$(ModGuid)\</ModDeployDir>
    <!-- Old flat place. Two copies of one guid = BepInEx load only one (maybe the stale one), so deploy remove it. -->
    <_ModLegacyDeployDir>$(BepInExDir)plugins\$(ModGuid)\</_ModLegacyDeployDir>
    <ModInfoFile>$(IntermediateOutputPath)ModInfo.g.cs</ModInfoFile>
    <!--
      Publicizer 0.4.3 rewrite IgnoresAccessChecksTo.cs EVERY build (File.WriteAllText, no compare), so CoreCompile
      always rerun and deploy always recopy (locked-dll warnings while game run). Me send its output to a raw file
      and copy to stable file only when content change (StabilizeIgnoresAccessChecksTo).
    -->
    <GeneratedIgnoresAccessChecksToFile>$(IntermediateOutputPath)$(MSBuildProjectName).IgnoresAccessChecksTo.raw.cs</GeneratedIgnoresAccessChecksToFile>
    <_IactStableFile>$(IntermediateOutputPath)$(MSBuildProjectName).IgnoresAccessChecksTo.cs</_IactStableFile>
  </PropertyGroup>

  <!-- Me check metadata early, before ref resolve spit confusing errors. -->
  <Target Name="ValidateMod" BeforeTargets="ResolveAssemblyReferences;CoreCompile" Condition="'$(IsMod)' == 'true'">
    <ItemGroup>
      <_ModRequireCheck Include="$(ModRequires)" />
    </ItemGroup>
    <Error Condition="!Exists('$(ValheimManagedDir)assembly_valheim.dll')"
           Text="Valheim not found at '$(ValheimRoot)'. Run tools/Setup.ps1, or set VALHEIM_DIR, or pass -p:ValheimDir=..." />
    <Error Condition="!Exists('$(BepInExDir)core\BepInEx.dll')"
           Text="BepInEx not installed in '$(ValheimRoot)'. Install BepInExPack_Valheim first." />
    <Error Condition="'$(ModCategory)' == ''"
           Text="Mod project name must be $(ModAuthor).&lt;Category&gt;.&lt;System&gt;.&lt;Feature&gt; (got '$(MSBuildProjectName)')." />
    <Error Condition="'$(ModCategory)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ModCategory)', '^(Combat|Exploration|Farming|Cooking|Building|Crafting|UX|Core)$'))"
           Text="Unknown category '$(ModCategory)'. Use Combat, Exploration, Farming, Cooking, Building, Crafting, UX (or Core for shared framework mods)." />
    <!-- Free text may hold apostrophes, which break '$(X)' == '' conditions. Me compare .Length instead. -->
    <Error Condition="'$(ModName.Length)' == '0'" Text="Set &lt;ModName&gt; in $(MSBuildProjectFile)." />
    <Error Condition="'$(ModDescription.Length)' == '0'" Text="Set &lt;ModDescription&gt; in $(MSBuildProjectFile)." />
    <Error Condition="$(ModDescription.Length) &gt; 250"
           Text="ModDescription is $(ModDescription.Length) chars; Thunderstore max is 250." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(Version)', '^\d+\.\d+\.\d+$'))"
           Text="Version must be Major.Minor.Patch (got '$(Version)')." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ModNetworkVersion)', '^\d+$'))"
           Text="ModNetworkVersion must be a whole number (got '$(ModNetworkVersion)')." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ModScope)', '^(QoL|Revamp|New)$'))"
           Text="ModScope must be QoL, Revamp or New (got '$(ModScope)')." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ModSide)', '^(Client|Server|Both)$'))"
           Text="ModSide must be Client (only the user needs it), Server (host/server needs it) or Both (everyone needs it). Got '$(ModSide)'." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ModMultiplayer)', '^(Compatible|Limited|SinglePlayer)$'))"
           Text="ModMultiplayer must be Compatible, Limited (explain in ModMultiplayerNotes) or SinglePlayer. Got '$(ModMultiplayer)'." />
    <Error Condition="'$(ModMultiplayer)' != 'Compatible' and '$(ModMultiplayerNotes.Length)' == '0'"
           Text="ModMultiplayer is '$(ModMultiplayer)': explain why in &lt;ModMultiplayerNotes&gt; (shown to players)." />
    <Error Condition="'$(ModSide)' != 'Client' and '$(ModMultiplayerNotes.Length)' == '0'"
           Text="ModSide is '$(ModSide)': explain in &lt;ModMultiplayerNotes&gt; why it cannot be client-side only (shown to players)." />
    <Error Condition="$(ModName.Contains('&quot;')) or $(ModDescription.Contains('&quot;')) or $(ModMultiplayerNotes.Contains('&quot;')) or $(ModName.Contains('`')) or $(ModMultiplayerNotes.Contains('`'))"
           Text="ModName, ModDescription and ModMultiplayerNotes cannot contain double quotes or backticks." />
    <!-- Per item, exact compare: substring check wrongly hit MC.X.Pins vs MC.X.PinsCore, and let comma lists through. -->
    <Error Condition="'%(_ModRequireCheck.Identity)' == '$(ModGuid)'" Text="A mod cannot require itself." />
    <Error Condition="'@(_ModRequireCheck)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('%(_ModRequireCheck.Identity)', '^[A-Za-z0-9_]+(\.[A-Za-z0-9_]+)+$'))"
           Text="ModRequires entry '%(_ModRequireCheck.Identity)' is not a mod GUID. Separate GUIDs with ';'." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ModPackageName)', '^[A-Za-z0-9_]+$'))"
           Text="ModPackageName '$(ModPackageName)' must match [A-Za-z0-9_]+ (Thunderstore rule)." />
  </Target>

  <!-- Me stamp build with git commit (+dirty) so test reports point at exact code. No git = "local". -->
  <Target Name="GetModBuildId" Condition="'$(IsMod)' == 'true'">
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(RepoRoot)" ConsoleToMSBuild="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitHash" />
      <Output TaskParameter="ExitCode" PropertyName="_GitHashExit" />
    </Exec>
    <Exec Command="git status --porcelain -- src tests Directory.Build.props Directory.Build.targets" WorkingDirectory="$(RepoRoot)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true"
          Condition="'$(_GitHashExit)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDirty" />
      <Output TaskParameter="ExitCode" PropertyName="_GitDirtyExit" />
    </Exec>
    <PropertyGroup>
      <ModBuildId>local</ModBuildId>
      <ModBuildId Condition="'$(_GitHashExit)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitHash)', '^[0-9a-f]{7,}$'))">$(_GitHash)</ModBuildId>
      <ModBuildId Condition="'$(ModBuildId)' != 'local' and '$(_GitDirtyExit)' == '0' and '$(_GitDirty.Length)' != '0'">$(ModBuildId)+dirty</ModBuildId>
    </PropertyGroup>
  </Target>

  <!--
    Me write ModInfo consts + descriptor, and plugin attributes on partial class Plugin
    (BepInPlugin, BepInProcess for client mods, soft BepInDependency per ModRequires).
    Csproj = one truth. Plugin code never hardcode guid/name/version/deps.
  -->
  <Target Name="GenerateModInfo" BeforeTargets="CoreCompile" DependsOnTargets="ValidateMod;GetModBuildId" Condition="'$(IsMod)' == 'true'">
    <ItemGroup>
      <_ModRequire Include="$(ModRequires)" />
    </ItemGroup>
    <PropertyGroup>
      <!--
        Free text -> C# string: me squash newlines/tabs to one space, and double backslash. Backticks around the
        argument because text holds apostrophes/commas. '%5C%5C' not '\\': MSBuild collapse '\\' in arguments.
        Property-function result come out escaped, so ';' no split WriteLinesToFile.
      -->
      <_ModNameCs>$([System.Text.RegularExpressions.Regex]::Replace(`$(ModName)`, `\s+`, ` `).Trim().Replace(`\`, `%5C%5C`))</_ModNameCs>
      <_ModNotesCs>$([System.Text.RegularExpressions.Regex]::Replace(`$(ModMultiplayerNotes)`, `\s+`, ` `).Trim().Replace(`\`, `%5C%5C`))</_ModNotesCs>
      <_ModRequiresCs>@(_ModRequire->'"%(Identity)"', ', ')</_ModRequiresCs>
      <_ModDependencyAttrs>@(_ModRequire->'[global::BepInEx.BepInDependency("%(Identity)", global::BepInEx.BepInDependency.DependencyFlags.SoftDependency)]', ' ')</_ModDependencyAttrs>
      <_ModProcessAttr Condition="'$(ModSide)' == 'Client'">[global::BepInEx.BepInProcess("valheim.exe")]</_ModProcessAttr>
      <_ModInfoText>// &lt;auto-generated/&gt;
// Me made by Directory.Build.targets from csproj props. No edit, me overwrite every build.
namespace $(RootNamespace)
{
    internal static class ModInfo
    {
        public const string Guid = "$(ModGuid)"%3B
        public const string Name = "$(_ModNameCs)"%3B
        public const string Version = "$(Version)"%3B
        public const string Build = "$(ModBuildId)"%3B
        public const string Author = "$(ModAuthor)"%3B
        public const string Category = "$(ModCategory)"%3B
        public const string Scope = "$(ModScope)"%3B
        public const string Side = "$(ModSide)"%3B
        public const string Multiplayer = "$(ModMultiplayer)"%3B
        public const string MultiplayerNotes = "$(_ModNotesCs)"%3B
        public const int NetworkVersion = $(ModNetworkVersion)%3B
        public static readonly string[] Requires = new string[] { $(_ModRequiresCs) }%3B

        public static readonly global::MC.Shared.ModDescriptor Descriptor = new global::MC.Shared.ModDescriptor(
            Guid, Name, Version, Build, Category, Scope, Side, Multiplayer, MultiplayerNotes, Requires, NetworkVersion)%3B
    }

    [global::BepInEx.BepInPlugin(ModInfo.Guid, ModInfo.Name, ModInfo.Version)]
    $(_ModProcessAttr)
    $(_ModDependencyAttrs)
    internal sealed partial class Plugin
    {
        protected override global::MC.Shared.ModDescriptor Descriptor =&gt; ModInfo.Descriptor%3B
    }
}
</_ModInfoText>
    </PropertyGroup>
    <WriteLinesToFile File="$(ModInfoFile)" Lines="$(_ModInfoText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(ModInfoFile)" />
      <FileWrites Include="$(ModInfoFile)" />
    </ItemGroup>
  </Target>

  <!-- Me copy publicizer output to stable file only when content change, and compile the stable one. -->
  <Target Name="StabilizeIgnoresAccessChecksTo" AfterTargets="Publicize" Condition="'$(IsMod)' == 'true' and Exists('$(GeneratedIgnoresAccessChecksToFile)')">
    <ReadLinesFromFile File="$(GeneratedIgnoresAccessChecksToFile)">
      <Output TaskParameter="Lines" ItemName="_IactLine" />
    </ReadLinesFromFile>
    <WriteLinesToFile File="$(_IactStableFile)" Lines="@(_IactLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Remove="$(GeneratedIgnoresAccessChecksToFile)" />
      <Compile Include="$(_IactStableFile)" />
      <FileWrites Include="$(_IactStableFile)" />
    </ItemGroup>
  </Target>

  <!-- Me copy dll + pdb (+ ModContent files) into BepInEx/plugins/<Collection>/<Category>/<Guid>/. Game running = dll locked = warning only. -->
  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(IsMod)' == 'true' and '$(DeployToGame)' == 'true'">
    <PropertyGroup>
      <_ModHadLegacy Condition="Exists('$(_ModLegacyDeployDir)')">true</_ModHadLegacy>
    </PropertyGroup>
    <RemoveDir Directories="$(_ModLegacyDeployDir)" Condition="'$(_ModHadLegacy)' == 'true'" ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="Removed old flat install $(_ModLegacyDeployDir)" Condition="'$(_ModHadLegacy)' == 'true' and !Exists('$(_ModLegacyDeployDir)')" />
    <ItemGroup>
      <_ModDeployFile Include="$(TargetPath)" />
      <_ModDeployFile Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(_ModDeployFile)" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="true" Retries="0" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="@(ModContent)" DestinationFiles="@(ModContent->'$(ModDeployDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" Retries="0" ContinueOnError="WarnAndContinue" Condition="'@(ModContent)' != ''" />
    <Message Importance="high" Text="$(ModGuid) -> $(ModDeployDir)" />
  </Target>

  <!-- dotnet build -t:UndeployMod : me remove mod from game plugins folder. -->
  <Target Name="UndeployMod" Condition="'$(IsMod)' == 'true'">
    <RemoveDir Directories="$(ModDeployDir);$(_ModLegacyDeployDir)" />
    <Message Importance="high" Text="Removed $(ModDeployDir)" />
  </Target>
</Project>
