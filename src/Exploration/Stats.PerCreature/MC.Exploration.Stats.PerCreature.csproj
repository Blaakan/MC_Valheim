<Project Sdk="Microsoft.NET.Sdk">
  <!-- Me = mod project. Guid, id, category come from file name. Build rules live in Directory.Build.props/.targets. -->
  <PropertyGroup>
    <ModName>Creature Kill and Tame Counts</ModName>
    <Version>0.1.0</Version>
    <ModScope>QoL</ModScope>
    <!-- Idea from the sheet this mod implement (tools/Update-Backlog.ps1 link them). -->
    <ModIdea>Per creature kill count</ModIdea>
    <ModSide>Client</ModSide>
    <ModMultiplayer>Compatible</ModMultiplayer>
    <ModMultiplayerNotes>Only you need it; it works on vanilla servers and with friends who do not have it. Kills follow the game's own rule: everyone who hit a creature gets the kill. A tame goes to the player the game tells it has been tamed (the closest one within 30 m). If nobody was that close, it goes to the player whose game ran the taming, unless that player's game sees another player closer to the creature, in which case nobody gets it (players far outside that game's loaded area are not seen).</ModMultiplayerNotes>
    <ModRequires></ModRequires>
    <ModDescription>Shows how many of each creature you have killed, and how, plus how many you have tamed, at the top of Player Statistics in the Valheim Compendium. Kills come from the game's own saved stats, so past kills show too. Tames count from install.</ModDescription>
  </PropertyGroup>
</Project>
