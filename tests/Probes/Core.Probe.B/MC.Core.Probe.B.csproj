  <PropertyGroup>
    <ModName>Probe B</ModName>
    <Version>0.0.1</Version>
    <ModScope>QoL</ModScope>
    <ModSide>Client</ModSide>
    <ModRequires>MC.Core.Probe.A</ModRequires>
    <ModDescription>Framework test probe that requires Probe A.</ModDescription>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\ProbePatch.cs" />
  </ItemGroup>
</Project>
